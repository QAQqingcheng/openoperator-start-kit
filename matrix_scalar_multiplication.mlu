// scalar_mul.mlu

#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 4096

__mlu_entry__ void scalar_mul_kernel(
    float *input,
    float *output,
    int total,
    float scalar) {

    // 多核拆分
    uint32_t core_id   = taskId;
    uint32_t core_num  = taskDim;
    uint32_t per_core  = total / core_num;
    uint32_t remainder = total % core_num;

    uint32_t start = core_id * per_core +
                     (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core +
                     (core_id < remainder ? 1 : 0);

    __nram__ float nram_input[CHUNK_SIZE];
    __nram__ float nram_output[CHUNK_SIZE];

    for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
        uint32_t len = (offset + CHUNK_SIZE <= count)
                           ? CHUNK_SIZE
                           : (count - offset);

        // 对齐到64的倍数，bang算子通常要求对齐
        uint32_t aligned_len = (len + 63) & ~63;

        // 从GDRAM加载数据到NRAM
        __memcpy(nram_input,
                 input + start + offset,
                 len * sizeof(float),
                 GDRAM2NRAM);

        // 逐元素乘以标量
        __bang_mul_scalar(nram_output,
                          nram_input,
                          scalar,
                          aligned_len);

        // 结果写回GDRAM
        __memcpy(output + start + offset,
                 nram_output,
                 len * sizeof(float),
                 NRAM2GDRAM);
    }
}


torch::Tensor bang_func(torch::Tensor A, double s) {
    // 检查输入是否连续
    TORCH_CHECK(A.is_contiguous(), "Input must be contiguous");

    // 保留原始数据类型
    auto original_dtype = A.scalar_type();

    // 转换为float进行计算
    torch::Tensor A_fp32 = A;
    if (original_dtype != torch::kFloat) {
        A_fp32 = A.to(torch::kFloat);
    }

    auto output_fp32 = torch::empty_like(A_fp32);
    int total = A_fp32.numel();

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    // 启动MLU内核
    scalar_mul_kernel<<<dim, ktype, queue>>>(
        A_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        total,
        static_cast<float>(s));

    // 如果原始类型不是float，转换回去
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }

    return output_fp32;
}