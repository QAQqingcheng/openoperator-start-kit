// LogSoftmax.mlu
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <cmath>

#define CHUNK_SIZE 4096

__mlu_entry__ void logsoftmax_kernel(
    float *input,
    float *output,
    int N,
    int D,
    int dim) {

    // 确定外层任务数
    int outer_size = (dim == 1) ? N : D;
    int inner_size = (dim == 1) ? D : N;

    // 多核拆分外层任务
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = outer_size / core_num;
    uint32_t remainder = outer_size % core_num;

    uint32_t start = core_id * per_core +
                     (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core +
                     (core_id < remainder ? 1 : 0);

    // NRAM 缓冲区
    __nram__ float nram_input[CHUNK_SIZE];
    __nram__ float nram_x_sub[CHUNK_SIZE];
    __nram__ float nram_exp[CHUNK_SIZE];
    __nram__ float nram_temp[CHUNK_SIZE];   // 用于广播标量等

    for (uint32_t i = 0; i < count; ++i) {
        uint32_t idx = start + i;

        // 加载当前外层元素对应的向量到 NRAM
        if (dim == 1) {
            // 行连续
            __memcpy(nram_input,
                     input + idx * D,
                     inner_size * sizeof(float),
                     GDRAM2NRAM);
        } else { // dim == 0
            // 列离散，stride = D
            __memcpy(nram_input,
                     input + idx,
                     inner_size * sizeof(float),
                     GDRAM2NRAM,
                     (uint32_t)(D * sizeof(float)),   // src stride
                     0, 0);
        }

        // ---- 数值稳定的 LogSoftmax 计算 ----
        // 1. 求最大值
        float max_val;
        __bang_reduce_max(&max_val, nram_input, inner_size);

        // 2. x_sub = x - max
        __bang_write_value(nram_temp, inner_size, max_val);
        __bang_sub(nram_x_sub, nram_input, nram_temp, inner_size);

        // 3. exp(x_sub)
        __bang_exp(nram_exp, nram_x_sub, inner_size);

        // 4. sum(exp)
        float sum_exp;
        __bang_reduce_sum(&sum_exp, nram_exp, inner_size);

        // 5. log(sum)
        float log_sum = logf(sum_exp);

        // 6. 结果 = x_sub - log_sum
        __bang_sub_scalar(nram_x_sub, nram_x_sub, log_sum, inner_size);

        // 写回输出
        if (dim == 1) {
            __memcpy(output + idx * D,
                     nram_x_sub,
                     inner_size * sizeof(float),
                     NRAM2GDRAM);
        } else {
            __memcpy(output + idx,
                     nram_x_sub,
                     inner_size * sizeof(float),
                     NRAM2GDRAM,
                     0,
                     (uint32_t)(D * sizeof(float)),   // dst stride
                     0);
        }
    }
}


torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(x.dim() == 2, "Input must be 2D tensor of shape [batch_size, dim]");
    TORCH_CHECK(dim == 0 || dim == 1, "dim must be 0 or 1");

    // 保留原始数据类型
    auto original_dtype = x.scalar_type();
    torch::Tensor x_fp32 = x;
    if (original_dtype != torch::kFloat) {
        x_fp32 = x.to(torch::kFloat);
    }

    auto output_fp32 = torch::empty_like(x_fp32);

    int N = x_fp32.size(0);
    int D = x_fp32.size(1);

    // 确保内部维度不超过单核 NRAM 上限（简化处理，实际可拓展）
    int inner_size = (dim == 1) ? D : N;
    TORCH_CHECK(inner_size <= CHUNK_SIZE,
                "Inner dimension too large for current CHUNK_SIZE, consider splitting");

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim_grid = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    logsoftmax_kernel<<<dim_grid, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        N, D, dim
    );

    // 转回原始类型
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}