#include <bang.h>
#include <torch/extension.h>

// 核函数：每个 cluster 处理一个输出块
__mlu_entry__ void MatMulKernel(half* A, half* B, half* C,
                                int M, int N, int K,
                                int lda, int ldb, int ldc) {
    // 获取当前 cluster 的索引（类似 CUDA 的 blockIdx）
    int cluster_x = __builtin_get_cluster_id_x();
    int cluster_y = __builtin_get_cluster_id_y();
    int cluster_z = __builtin_get_cluster_id_z();

    // 每个 cluster 负责一个 64×64 的输出块（可调）
    const int TILE_M = 64;
    const int TILE_N = 64;

    int start_m = cluster_x * TILE_M;
    int start_n = cluster_y * TILE_N;

    // 边界检查
    if (start_m >= M || start_n >= N) return;

    int actual_m = (start_m + TILE_M > M) ? (M - start_m) : TILE_M;
    int actual_n = (start_n + TILE_N > N) ? (N - start_n) : TILE_N;

    // 分配 NRAM 空间（片上内存）
    __nram__ half tileA[TILE_M * K];   // 实际只用 actual_m 行
    __nram__ half tileB[K * TILE_N];   // 实际只用 actual_n 列
    __nram__ half tileC[TILE_M * TILE_N];

    // 将 A 的对应块加载到 NRAM（按行主序，lda 是 K）
    for (int i = 0; i < actual_m; i++) {
        __memcpy(tileA + i * K, A + (start_m + i) * lda, K * sizeof(half), GDRAM2NRAM);
    }
    // 将 B 的对应块加载到 NRAM（按列主序？B 按行存储，ldb = N）
    // 注意矩阵乘法需要 B 的连续列，这里直接拷贝整块，因为 __bang_matmul 会处理好
    for (int j = 0; j < actual_n; j++) {
        __memcpy(tileB + j, B + (start_n + j), K * sizeof(half), GDRAM2NRAM); // 错误！需要逐列拷贝
    }

    // 正确做法：B 以列优先拷贝到 NRAM，使 K 维连续
    // 实际上 __bang_matmul 要求 A 按行，B 按列，C 按行
    // 这里简化：使用 BANG 提供的矩阵乘法库函数 __bang_matmul
    // 它会自动处理布局，我们只需提供正确的指针和维度
}

// 更简单可靠的方法：直接调用硬件加速的 __bang_matmul 库函数
__mlu_entry__ void MatMulKernelSimple(half* A, half* B, half* C,
                                      int M, int N, int K) {
    // __bang_matmul 是 BANG 内置的矩阵乘法指令，一次完成整个矩阵乘法
    // 参数：C, A, B, M, N, K, lda, ldb, ldc
    // 这里假设 A, B, C 都是行主序，lda = K, ldb = N, ldc = N
    __bang_matmul(C, A, B, M, N, K, K, N, N);
}

// 封装成 torch 可调用的接口
torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    // 检查维度
    TORCH_CHECK(A.dim() == 2, "A must be 2D");
    TORCH_CHECK(B.dim() == 2, "B must be 2D");
    TORCH_CHECK(A.size(1) == B.size(0), "Matrix dimension mismatch");
    TORCH_CHECK(A.scalar_type() == torch::kFloat16, "A must be float16");
    TORCH_CHECK(B.scalar_type() == torch::kFloat16, "B must be float16");

    int M = A.size(0);
    int K = A.size(1);
    int N = B.size(1);

    // 创建输出张量 C
    auto C = torch::empty({M, N}, A.options());

    // 获取设备指针
    half* A_ptr = reinterpret_cast<half*>(A.data_ptr());
    half* B_ptr = reinterpret_cast<half*>(B.data_ptr());
    half* C_ptr = reinterpret_cast<half*>(C.data_ptr());

    // 根据矩阵大小选择合适的核函数配置
    // 对于中小尺寸，一个 cluster 即可
    cnrtDim3_t dim = {1, 1, 1};   // 只使用一个 cluster
    cnrtFunctionType_t ktype = CNRT_FUNC_TYPE_BLOCK;

    // 启动核函数
    MatMulKernelSimple<<<dim, ktype, 0>>>(A_ptr, B_ptr, C_ptr, M, N, K);

    return C;
}