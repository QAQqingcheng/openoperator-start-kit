// matmul.mlu
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

// 假设 K 不超过 4096，便于在 NRAM 中分配静态缓冲区
#define MAX_K 4096

// 核函数：计算 C = A * B
// A: [M, K], B: [K, N], C: [M, N]
__mlu_entry__ void matmul_kernel(
    float *A,
    float *B,
    float *C,
    int M, int K, int N) {

    // 多核分配行（M 维度）
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = M / core_num;
    uint32_t remainder = M % core_num;
    uint32_t start_row = core_id * per_core +
                         (core_id < remainder ? core_id : remainder);
    uint32_t num_rows = per_core +
                        (core_id < remainder ? 1 : 0);

    // 对齐 K 到 64 的倍数（向量化操作要求）
    uint32_t aligned_K = (K + 63) & ~63;
    // 断言 K 不超过 MAX_K
    if (K > MAX_K) {
        // 实际生产中应实现 K 分块，此处简化处理
        return;
    }

    // NRAM 缓冲区（均为 float，大小 MAX_K）
    __nram__ float a_row_orig[MAX_K];
    __nram__ float b_col_buf[MAX_K];
    __nram__ float temp_buf[MAX_K];

    // 遍历当前核负责的行
    for (uint32_t row = start_row; row < start_row + num_rows; ++row) {
        // 1. 加载 A 的一行到 a_row_orig，并补齐对齐部分为零
        __memcpy(a_row_orig, A + row * K, K * sizeof(float), GDRAM2NRAM);
        if (aligned_K > K) {
            __bang_memset((void*)(a_row_orig + K), 0,
                          (aligned_K - K) * sizeof(float));
        }

        // 2. 遍历所有列 (n)
        for (int n = 0; n < N; ++n) {
            // 2.1 加载 B 的一列（从 B 的列主序位置）
            // 使用 2D memcpy: 源步长为 N * sizeof(float)，目标步长为 sizeof(float)
            // 复制 K 行，每行 1 个元素
            __memcpy(b_col_buf,          // 目标地址
                     B + n,              // 源起始地址 (第 0 行第 n 列)
                     K,                  // 行数
                     1,                  // 列数
                     GDRAM2NRAM,         // 传输方向
                     N * sizeof(float),  // 源行步长 (行主序，行间跳 N 个元素)
                     sizeof(float));     // 目标行步长 (连续存放)

            // 补齐对齐部分为零
            if (aligned_K > K) {
                __bang_memset((void*)(b_col_buf + K), 0,
                              (aligned_K - K) * sizeof(float));
            }

            // 2.2 计算点积: sum_k a_row[k] * b_col[k]
            // 逐元素乘 -> temp_buf
            __bang_mul(temp_buf, a_row_orig, b_col_buf, aligned_K);
            // 求和归约 -> 结果存于 temp_buf[0]
            __bang_sum_reduce(temp_buf, aligned_K);

            // 2.3 写回 C[row][n]
            C[row * N + n] = temp_buf[0];
        }
    }
}

// 外部调用函数，必须命名为 bang_func
torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    // 基本检查
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
    TORCH_CHECK(A.dim() == 2 && B.dim() == 2, "A and B must be 2D");
    TORCH_CHECK(A.size(1) == B.size(0), "Inner dims must match (A: MxK, B: KxN)");

    // 保留原始 dtype（要求为 float16）
    auto original_dtype = A.scalar_type();
    // 内部统一使用 float 计算
    torch::Tensor A_fp32 = A;
    torch::Tensor B_fp32 = B;
    if (original_dtype != torch::kFloat) {
        A_fp32 = A.to(torch::kFloat);
        B_fp32 = B.to(torch::kFloat);
    }

    int M = A_fp32.size(0);
    int K = A_fp32.size(1);
    int N = B_fp32.size(1);
    auto C_fp32 = torch::empty({M, N}, A_fp32.options());

    // MLU 流及核函数配置（4 核并行）
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    matmul_kernel<<<dim, ktype, queue>>>(
        A_fp32.data_ptr<float>(),
        B_fp32.data_ptr<float>(),
        C_fp32.data_ptr<float>(),
        M, K, N
    );

    // 转回原始 dtype (float16)
    if (original_dtype != torch::kFloat) {
        return C_fp32.to(original_dtype);
    }
    return C_fp32;
}