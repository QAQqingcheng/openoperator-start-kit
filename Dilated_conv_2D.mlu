#include <bang.h>

#define CHUNK_SIZE 4096

__mlu_entry__ void conv2d_kernel(
    const float *input,          // [batch, in_channels, H, W]
    const float *kernel,         // [out_channels, in_channels, K, K]
    float       *output,         // [batch, out_channels, H_out, W_out]
    int batch,
    int in_channels,
    int out_channels,
    int H,
    int W,
    int K,                       // kernel_size
    int dilation,
    int padding,
    int H_out,
    int W_out)
{
    // ==================== 多核拆分 ====================
    uint32_t core_id  = taskId;
    uint32_t core_num = taskDim;

    int H_out_W_out      = H_out * W_out;
    int out_per_batch    = out_channels * H_out_W_out;
    uint32_t total_elems = (uint32_t)batch * out_per_batch;

    uint32_t per_core  = total_elems / core_num;
    uint32_t remainder = total_elems % core_num;

    uint32_t start = core_id * per_core +
                     (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core +
                     (core_id < remainder ? 1 : 0);

    // ==================== 常量 ====================
    int K2          = K * K;
    int kernel_len  = in_channels * K2;         // 每个输出通道的权重个数
    int in_spatial  = in_channels * H * W;      // 每个 batch 的输入元素数

    // ==================== NRAM 缓冲区 ====================
    __nram__ float nram_kernel[CHUNK_SIZE];     // 权重块
    __nram__ float nram_patch[CHUNK_SIZE];      // 输入块
    __nram__ float nram_mul[CHUNK_SIZE];        // 逐元素乘积
    __nram__ float nram_sum[1];                 // 块内和
    __nram__ float nram_acc[1];                 // 累加器

    // ==================== 逐输出元素计算 ====================
    for (uint32_t idx = start; idx < start + count; ++idx) {

        // ---- 解码展平索引 → (b, oc, oh, ow) ----
        uint32_t tmp = idx;
        int b  = tmp / out_per_batch;
        tmp   %= out_per_batch;
        int oc = tmp / H_out_W_out;
        tmp   %= H_out_W_out;
        int oh = tmp / W_out;
        int ow = tmp % W_out;

        // 累加器初始化为 0
        __bang_mul_scalar(nram_acc, nram_acc, 0.0f, 1);

        // ---- 分块处理 kernel_len 个权重点积 ----
        int offset = 0;  // 块起始偏移（元素个数）
        while (offset < kernel_len) {
            int cur_len = kernel_len - offset;
            if (cur_len > CHUNK_SIZE)
                cur_len = CHUNK_SIZE;

            // 1) 加载权重块 [oc, offset : offset+cur_len]
            __memcpy(nram_kernel,
                     kernel + oc * kernel_len + offset,
                     cur_len * sizeof(float),
                     GDRAM2NRAM);

            // 2) 收集对应的感受野块（padding 通过置零实现）
            //    先将 nram_patch 对应区域全置零
            __bang_mul_scalar(nram_patch, nram_patch, 0.0f, cur_len);

            int pos_in_block = 0;  // 在 nram_patch 块内的偏移
            int global_pos   = offset; // 全局偏移（对应权重索引）
            // 需要遍历 ic, kh, kw 找到属于当前块的元素
            // 因为 offset 可能不在通道或空间边界对齐，采用全局线性搜索
            for (int ic = 0; ic < in_channels && global_pos < offset + cur_len; ++ic) {
                for (int kh = 0; kh < K && global_pos < offset + cur_len; ++kh) {
                    int hi = oh + kh * dilation - padding;
                    if (hi < 0 || hi >= H) {
                        // 整行越界，跳过 K 个位置
                        int skip = K;
                        if (global_pos < offset) {
                            // 不在当前块内，仅更新 global_pos
                            int advance = (global_pos + skip > offset + cur_len) ?
                                          (offset + cur_len - global_pos) : skip;
                            pos_in_block += advance;
                            global_pos  += advance;
                        } else {
                            // 在块内，nram_patch 已经为 0，只需更新全局位置
                            pos_in_block += K;
                            global_pos  += K;
                        }
                        continue;
                    }
                    for (int kw = 0; kw < K && global_pos < offset + cur_len; ++kw) {
                        if (global_pos < offset) {
                            // 还未进入当前块，跳过
                            ++global_pos;
                            continue;
                        }
                        // 此时 global_pos 在 [offset, offset+cur_len) 内
                        int wi = ow + kw * dilation - padding;
                        if (wi >= 0 && wi < W) {
                            int src_idx = b * in_spatial
                                        + ic * (H * W)
                                        + hi * W
                                        + wi;
                            __memcpy(nram_patch + pos_in_block,
                                     input + src_idx,
                                     sizeof(float),
                                     GDRAM2NRAM);
                        }
                        ++pos_in_block;
                        ++global_pos;
                    }
                }
            }

            // 3) 逐元素乘
            __bang_mul(nram_mul, nram_kernel, nram_patch, cur_len);

            // 4) 块内求和（需要对齐长度）
            int aligned_len = (cur_len + 63) & ~63;
            __bang_nanosum(nram_sum, nram_mul, aligned_len);  // 结果在 nram_sum[0]

            // 5) 累加到总累加器
            __bang_add_scalar(nram_acc, nram_acc, nram_sum[0], 1);

            offset += cur_len;
        }

        // ---- 写出最终结果 ----
        int dst_idx = b * out_per_batch
                    + oc * H_out_W_out
                    + oh * W_out
                    + ow;
        __memcpy(output + dst_idx, nram_acc, sizeof(float), NRAM2GDRAM);
    }
}


// ==================== C++ Wrapper（保持不变） ====================
#include <torch/extension.h>
#include <cnrt.h>

torch::Tensor bang_func(
    torch::Tensor x,               // [batch, in_channels, H, W]
    torch::Tensor kernel,          // [out_channels, in_channels, K, K]
    int in_channels,
    int out_channels,
    int kernel_size,
    int dilation,
    int padding)
{
    TORCH_CHECK(x.is_contiguous(),  "Input x must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");
    TORCH_CHECK(x.dim() == 4,       "Input must be 4-D");
    TORCH_CHECK(kernel.dim() == 4,  "Kernel must be 4-D");

    int batch   = x.size(0);
    int H       = x.size(2);
    int W       = x.size(3);
    int K       = kernel_size;

    int H_out = H + 2 * padding - dilation * (K - 1);
    int W_out = W + 2 * padding - dilation * (K - 1);

    TORCH_CHECK(H_out > 0 && W_out > 0,
                "Invalid padding/dilation: output spatial dims must be positive");

    auto original_dtype = x.scalar_type();

    torch::Tensor x_fp32 = x;
    torch::Tensor k_fp32 = kernel;
    if (original_dtype != torch::kFloat) {
        x_fp32 = x.to(torch::kFloat);
        k_fp32 = kernel.to(torch::kFloat);
    }

    auto output_fp32 = torch::empty(
        {batch, out_channels, H_out, W_out},
        x_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim   = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    conv2d_kernel<<<dim, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        k_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        batch,
        in_channels,
        out_channels,
        H,
        W,
        K,
        dilation,
        padding,
        H_out,
        W_out);

    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}