// bang.mlu
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define NRAM_HALF_SIZE (128 * 1024)  // 128K half 元素

/**
 * 核函数：带空洞和填充的二维卷积 (float16)
 * x:      [batch, in_channels, H, W]
 * kernel: [out_channels, in_channels, kernel_size, kernel_size]
 * output: [batch, out_channels, H_out, W_out]
 */
__mlu_entry__ void dilated_conv2d_kernel(
    half *x,
    half *kernel,
    half *output,
    int batch,
    int in_channels,
    int out_channels,
    int H,
    int W,
    int kernel_size,
    int dilation,
    int padding)
{
    // 输出尺寸
    int H_out = (H + 2 * padding - dilation * (kernel_size - 1) - 1) + 1;
    int W_out = (W + 2 * padding - dilation * (kernel_size - 1) - 1) + 1;
    int total_out = batch * out_channels * H_out * W_out;

    // 多核拆分
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = total_out / core_num;
    uint32_t remainder = total_out % core_num;

    uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core + (core_id < remainder ? 1 : 0);
    if (count == 0) return;

    // NRAM 缓冲区
    __nram__ float nram_accum;

    for (uint32_t i = 0; i < count; ++i) {
        int global_idx = start + i;

        // 将一维索引映射到 [n, c_out, h, w]
        int n = global_idx / (out_channels * H_out * W_out);
        int r1 = global_idx % (out_channels * H_out * W_out);
        int c_out = r1 / (H_out * W_out);
        int r2 = r1 % (H_out * W_out);
        int h_out = r2 / W_out;
        int w_out = r2 % W_out;

        // 计算对应输入起始位置（考虑 padding）
        int h_in_start = h_out - padding;
        int w_in_start = w_out - padding;

        float sum = 0.0f;

        // 遍历输入通道和卷积核
        for (int c_in = 0; c_in < in_channels; ++c_in) {
            for (int ki = 0; ki < kernel_size; ++ki) {
                int h_in = h_in_start + ki * dilation;
                if (h_in < 0 || h_in >= H) continue;

                for (int kj = 0; kj < kernel_size; ++kj) {
                    int w_in = w_in_start + kj * dilation;
                    if (w_in < 0 || w_in >= W) continue;

                    // 计算输入元素地址
                    int x_idx = n * (in_channels * H * W)
                              + c_in * (H * W)
                              + h_in * W
                              + w_in;

                    // 计算卷积核元素地址
                    int k_idx = c_out * (in_channels * kernel_size * kernel_size)
                              + c_in * (kernel_size * kernel_size)
                              + ki * kernel_size
                              + kj;

                    sum += (float)x[x_idx] * (float)kernel[k_idx];
                }
            }
        }

        output[global_idx] = (half)sum;
    }
}

/**
 * 外部调用函数：必须与 C++ Wrapper 签名完全一致
 * torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel,
 *                         int in_channels, int out_channels,
 *                         int kernel_size, int dilation, int padding);
 */
torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int dilation,
    int padding)
{
    // 类型检查
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "kernel must be contiguous");
    TORCH_CHECK(x.scalar_type() == torch::kHalf, "x must be float16");
    TORCH_CHECK(kernel.scalar_type() == torch::kHalf, "kernel must be float16");

    // 获取输入形状
    auto dims = x.sizes();
    int batch = dims[0];
    int H = dims[2];
    int W = dims[3];

    // 计算输出尺寸
    int H_out = (H + 2 * padding - dilation * (kernel_size - 1) - 1) + 1;
    int W_out = (W + 2 * padding - dilation * (kernel_size - 1) - 1) + 1;

    // 创建输出张量
    auto output = torch::empty({batch, out_channels, H_out, W_out}, x.options());

    // 获取 MLU 流
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    // 设置并行维度（4 核）
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    // 启动核函数
    dilated_conv2d_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<half*>(x.data_ptr<at::Half>()),
        reinterpret_cast<half*>(kernel.data_ptr<at::Half>()),
        reinterpret_cast<half*>(output.data_ptr<at::Half>()),
        batch,
        in_channels,
        out_channels,
        H,
        W,
        kernel_size,
        dilation,
        padding
    );

    return output;
}