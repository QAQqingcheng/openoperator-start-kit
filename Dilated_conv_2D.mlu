// ==================== conv2d.mlu ====================
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 4096

/**
 * @brief 此内核计算矩阵乘法 C = A × Bᵗ，其中：
 *        A : [M, K] — 权重矩阵
 *        B : [tasks, K] — im2col 展开 + permute 后的输入矩阵
 *        C : [tasks, M] — 每个任务产生 M 个输出
 *
 * 任务分配：按 (batch, spatial) 三元组拆分
 */
__mlu_entry__ void matmul_kernel(
    const float* A,          // [M, K]   权重
    const float* B,          // [tasks, K]   im2col 结果，行连续
    float* C,                // [tasks, M]   输出
    int tasks,               // batch × H_out × W_out
    int M,                   // out_channels
    int K) {                 // in_channels × kernel_size × kernel_size

    // ---------- 多核工作拆分 ----------
    uint32_t tid      = taskId;
    uint32_t ncores   = taskDim;
    uint32_t per_core = tasks / ncores;
    uint32_t rem      = tasks % ncores;
    uint32_t start    = tid * per_core + (tid < rem ? tid : rem);
    uint32_t count    = per_core + (tid < rem ? 1 : 0);
    uint32_t end      = start + count;

    // ---------- NRAM 缓冲区 ----------
    __nram__ float nram_B_row[CHUNK_SIZE];    // B 的一整行
    __nram__ float nram_A_row[CHUNK_SIZE];    // A 的一整行
    __nram__ float nram_mul  [CHUNK_SIZE];    // 逐元素乘积

    // 将 K 补齐到 2 的幂，便于树形规约
    int K_pow2 = 1;
    while (K_pow2 < K) K_pow2 <<= 1;

    // ---------- 每个 task 计算 ----------
    for (uint32_t idx = start; idx < end; ++idx) {

        // 从 GDRAM 加载 B 的一整行（B[idx, :]）
        __memcpy(nram_B_row,
                 B + idx * K,
                 K * sizeof(float),
                 GDRAM2NRAM);

        // B 行补零到 K_pow2
        for (int k = K; k < K_pow2; ++k) nram_B_row[k] = 0.0f;

        // 对每个输出通道 m 计算点积
        for (int m = 0; m < M; ++m) {

            // 加载 A 的第 m 行
            __memcpy(nram_A_row,
                     A + m * K,
                     K * sizeof(float),
                     GDRAM2NRAM);

            // A 行补零到 K_pow2
            for (int k = K; k < K_pow2; ++k) nram_A_row[k] = 0.0f;

            // 向量化逐元素乘法
            __bang_mul(nram_mul, nram_A_row, nram_B_row, K_pow2);

            // ---------- 树形并行规约求和 ----------
            for (int step = K_pow2 >> 1; step > 0; step >>= 1) {
                __bang_add(nram_mul,
                           nram_mul,
                           nram_mul + step,
                           step);
            }

            // 写出结果
            C[idx * M + m] = nram_mul[0];
        }
    }
}


// ==================== C++ Wrapper ====================
torch::Tensor bang_func(
    torch::Tensor x,           // [batch, in_c, H, W]
    torch::Tensor kernel,      // [out_c, in_c, kH, kW]
    int in_channels,
    int out_channels,
    int kernel_size,
    int dilation,
    int padding) {

    TORCH_CHECK(x.is_contiguous(),     "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");

    int batch  = x.size(0);
    int H     = x.size(2);
    int W     = x.size(3);

    // ----- 计算输出尺寸 -----
    int H_out = H + 2 * padding - dilation * (kernel_size - 1);
    int W_out = W + 2 * padding - dilation * (kernel_size - 1);

    // ----- 转为 float32 -----
    auto x_fp32 = (x.scalar_type() == torch::kFloat) ? x : x.to(torch::kFloat);
    auto k_fp32 = (kernel.scalar_type() == torch::kFloat)
                       ? kernel : kernel.to(torch::kFloat);

    // ==================== im2col ====================
    // unfold 输出 [batch, in_c * kH * kW, H_out * W_out]
    auto B = torch::nn::functional::unfold(
        x_fp32,
        torch::nn::functional::UnfoldFuncOptions(
            {kernel_size, kernel_size})
            .dilation({dilation, dilation})
            .padding({padding, padding}));

    // 转置为 [batch * H_out * W_out, in_c * kH * kW]
    auto B_t = B.transpose(1, 2).contiguous().view({-1, in_channels * kernel_size * kernel_size});

    // ---- 权重展平为 [out_c, in_c * kH * kW] ----
    auto A = k_fp32.reshape({out_channels, in_channels * kernel_size * kernel_size})
                    .contiguous();

    int tasks = batch * H_out * W_out;
    int M      = out_channels;
    int K      = in_channels * kernel_size * kernel_size;

    // ---- 输出 [tasks, M] ----
    auto C = torch::zeros({tasks, M}, x_fp32.options());

    // ==================== 启动 MLU 内核 ====================
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {16, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    matmul_kernel<<<dim, ktype, queue>>>(
        A.data_ptr<float>(),
        B_t.data_ptr<float>(),
        C.data_ptr<float>(),
        tasks,
        M,
        K);

    // 同步等待
    cnrtQueueSync(queue);

    // 恢复到 [batch, out_c, H_out, W_out]
    auto output = C.view({batch, H_out, W_out, out_channels})
                    .permute({0, 3, 1, 2})
                    .contiguous();

    if (x.scalar_type() != torch::kFloat) {
        output = output.to(x.scalar_type());
    }
    return output;
}