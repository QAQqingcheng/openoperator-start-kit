// bang.mlu
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define NRAM_SIZE (256 * 1024)  // 256KB NRAM

/**
 * 核函数：处理不规则形状的矩阵乘法
 * A: [M, K], B: [K, N], C: [M, N]
 * 支持非对齐的 M, N, K
 */
__mlu_entry__ void matmul_irregular_kernel(
    half *A,        // 输入 A [M, K]
    half *B,        // 输入 B [K, N]
    half *C,        // 输出 C [M, N]
    int M,
    int N,
    int K)
{
    // 多核拆分：按输出行 M 维度拆分
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = M / core_num;
    uint32_t remainder = M % core_num;

    uint32_t m_start = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t m_count = per_core + (core_id < remainder ? 1 : 0);
    if (m_count == 0) return;

    // ---------- 对齐参数 ----------
    // K 按 64 对齐（half = 2字节，64元素=128字节，满足 NRAM 对齐要求）
    int aligned_k = (K + 63) & ~63;

    // 每块处理的 N 列数（根据 NRAM 大小估算）
    int max_n_block = NRAM_SIZE / (aligned_k * sizeof(half) * 2 + 4096);
    if (max_n_block < 1) max_n_block = 1;
    if (max_n_block > N) max_n_block = N;

    int n_blocks = (N + max_n_block - 1) / max_n_block;

    // NRAM 缓冲区
    __nram__ half nram_a_row[4096];    // 存储当前行 A，最大 K 对齐后长度
    __nram__ half nram_b_block[4096];  // 存储 B 的一个列块
    __nram__ float nram_c_part[4096];  // 累加结果（float 精度）
    __nram__ half nram_c_half[4096];   // 转回 half 的结果

    for (uint32_t mi = 0; mi < m_count; ++mi) {
        int m_idx = m_start + mi;

        // 将 A 的第 m_idx 行加载到 NRAM
        __memcpy(nram_a_row,
                 A + m_idx * K,
                 K * sizeof(half),
                 GDRAM2NRAM);
        // 将对齐部分（超出 K 的部分）置零
        if (aligned_k > K) {
            // 使用循环赋零代替 __bang_memset
            for (int i = K; i < aligned_k; i++) {
                nram_a_row[i] = (half)0.0f;
            }
        }

        // 按列块处理
        for (int nb = 0; nb < n_blocks; ++nb) {
            int n_start = nb * max_n_block;
            int cur_n = (nb == n_blocks - 1) ? (N - n_start) : max_n_block;
            if (cur_n <= 0) break;
            int aligned_n = (cur_n + 63) & ~63;

            // 初始化累加器为 0（float）
            for (int i = 0; i < aligned_n; i++) {
                nram_c_part[i] = 0.0f;
            }

            // 加载 B 的列块：B[0:K, n_start:n_start+cur_n]
            // B 按行存储，但我们需要按列访问，所以需要分段加载
            // 这里简化：将 B 的该列块逐行复制到 NRAM 的连续区域
            for (int k = 0; k < K; ++k) {
                // 复制 B[k][n_start:n_start+cur_n] 到 nram_b_block
                __memcpy(nram_b_block,
                         B + k * N + n_start,
                         cur_n * sizeof(half),
                         GDRAM2NRAM);
                // 对齐部分补零
                for (int i = cur_n; i < aligned_n; i++) {
                    nram_b_block[i] = (half)0.0f;
                }

                // 标量乘法累加：a_row[k] * b_block[0:aligned_n]
                half a_val = nram_a_row[k];
                for (int i = 0; i < aligned_n; i++) {
                    nram_c_part[i] += (float)a_val * (float)nram_b_block[i];
                }
            }

            // 将 float 结果转回 half
            for (int i = 0; i < aligned_n; i++) {
                nram_c_half[i] = (half)nram_c_part[i];
            }

            // 写回 C[m_idx][n_start:n_start+cur_n]
            __memcpy(C + m_idx * N + n_start,
                     nram_c_half,
                     cur_n * sizeof(half),
                     NRAM2GDRAM);
        }
    }
}

/**
 * 外部调用函数
 */
torch::Tensor bang_func(
    torch::Tensor A,
    torch::Tensor B,
    int M,
    int N,
    int K)
{
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
    TORCH_CHECK(A.scalar_type() == torch::kHalf, "A must be float16");
    TORCH_CHECK(B.scalar_type() == torch::kHalf, "B must be float16");
    TORCH_CHECK(A.size(0) == M && A.size(1) == K, "A shape mismatch");
    TORCH_CHECK(B.size(0) == K && B.size(1) == N, "B shape mismatch");

    auto C = torch::empty({M, N}, A.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    // 关键修正：使用 reinterpret_cast<half*> 进行类型转换
    matmul_irregular_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<half*>(A.data_ptr<at::Half>()),
        reinterpret_cast<half*>(B.data_ptr<at::Half>()),
        reinterpret_cast<half*>(C.data_ptr<at::Half>()),
        M, N, K
    );

    return C;
}