// ==================== conv2d.mlu ====================
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 4096

__mlu_entry__ void conv2d_kernel(
    const float* input,
    const float* kernel,
    float* output,
    int batch,
    int in_c,
    int out_c,
    int H,
    int W,
    int H_out,
    int W_out,
    int kernel_size,
    int dilation,
    int padding) {

    // ========== 多核任务拆分 ==========
    int total = batch * out_c * H_out * W_out;
    uint32_t core_id   = taskId;
    uint32_t core_num  = taskDim;
    uint32_t per_core  = total / core_num;
    uint32_t remainder = total % core_num;

    uint32_t start = core_id * per_core +
                     (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core +
                     (core_id < remainder ? 1 : 0);

    // ========== NRAM 缓冲区 ==========
    __nram__ float nram_out[CHUNK_SIZE];

    // 本核负责的输出元素范围
    uint32_t end = start + count;

    for (uint32_t base = start; base < end; base += CHUNK_SIZE) {

        uint32_t len = (base + CHUNK_SIZE <= end)
                           ? CHUNK_SIZE
                           : (end - base);

        // 逐元素计算并写入 NRAM
        for (uint32_t local = 0; local < len; ++local) {
            uint32_t idx = base + local;

            // 线性索引 → (n, oc, hout, wout)
            int n   = idx / (out_c * H_out * W_out);
            int rem = idx % (out_c * H_out * W_out);
            int oc  = rem / (H_out * W_out);
            int spt = rem % (H_out * W_out);
            int hout = spt / W_out;
            int wout = spt % W_out;

            float sum = 0.0f;

            // 三层循环完成卷积累加
            for (int ic = 0; ic < in_c; ++ic) {
                for (int kh = 0; kh < kernel_size; ++kh) {
                    for (int kw = 0; kw < kernel_size; ++kw) {
                        int hin = hout - padding + kh * dilation;
                        int win = wout - padding + kw * dilation;
                        if (hin >= 0 && hin < H && win >= 0 && win < W) {
                            float x_val = input[
                                ((n * in_c + ic) * H + hin) * W + win];
                            float k_val = kernel[
                                ((oc * in_c + ic) * kernel_size + kh) * kernel_size + kw];
                            sum += x_val * k_val;
                        }
                    }
                }
            }
            nram_out[local] = sum;
        }

        // NRAM → GDRAM 批量写回
        __memcpy(
            output + base,
            nram_out,
            len * sizeof(float),
            NRAM2GDRAM);
    }
}


// ==================== C++ Wrapper ====================
torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int dilation,
    int padding) {

    TORCH_CHECK(x.is_contiguous(),     "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");

    int batch = x.size(0);
    int H = x.size(2);
    int W = x.size(3);

    // 输出尺寸（stride = 1）
    int H_out = H + 2 * padding - dilation * (kernel_size - 1);
    int W_out = W + 2 * padding - dilation * (kernel_size - 1);

    // 类型统一为 float
    auto original_dtype = x.scalar_type();
    torch::Tensor x_fp32 = x;
    torch::Tensor k_fp32 = kernel;
    if (original_dtype != torch::kFloat) {
        x_fp32 = x.to(torch::kFloat);
        k_fp32 = kernel.to(torch::kFloat);
    }

    auto output_fp32 = torch::empty(
        {batch, out_channels, H_out, W_out},
        x_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    conv2d_kernel<<<dim, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        k_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        batch,
        in_channels,
        out_channels,
        H,
        W,
        H_out,
        W_out,
        kernel_size,
        dilation,
        padding);

    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}